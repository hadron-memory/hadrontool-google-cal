# Port the HTTP server listens on.
PORT=8080

# Node environment. `development` relaxes the boot guards below.
NODE_ENV=development

# ── Inbound auth ─────────────────────────────────────────────────────────
# Shared bearer token: every /ops/*, /connections* request must send
#   Authorization: Bearer <GOOGLE_CAL_TOOL_TOKEN>
# hadron-server holds the same value as GOOGLE_CAL_TOOL_TOKEN.
# Required in production — the service refuses to start without it.
GOOGLE_CAL_TOOL_TOKEN=

# ── Database ─────────────────────────────────────────────────────────────
# The tool's OWN database (never core's). Holds encrypted refresh tokens and
# idempotency records.
# Required in production — the service refuses to start without it.
DATABASE_URL=postgresql://holger@localhost:5432/hadrontool_google_cal

# ── Secrets ──────────────────────────────────────────────────────────────
# 32-byte hex key for AES-256-GCM encryption of refresh tokens at rest.
# Distinct from core's HADRON_ENCRYPTION_KEY and from every sibling tool's
# key by design. Required in production.
TOKEN_ENCRYPTION_KEY=

# ── Google OAuth client (the CALENDAR client — never the login project's) ─
# The tool owns the client secret; hadron-server only builds the user-facing
# authorize URL (client id is public, mirrored there as GOOGLE_CAL_CLIENT_ID).
# Without these, /connections and all calendar operations return typed
# errors — the HTTP surface still boots.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Max request body size accepted by the JSON parser.
MAX_BODY_SIZE=1mb
